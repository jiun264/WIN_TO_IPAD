<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyName>PhotoBridge</AssemblyName>
    <RootNamespace>PhotoBridge.PC</RootNamespace>

    <!-- 微軟商店與生產發行標準中繼資料 -->
    <Title>PhotoBridge</Title>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>jiun264</Authors>
    <Company>jiun264</Company>
    <Product>PhotoBridge</Product>
    <Description>PC to iPad High-Speed LAN Photo Transfer</Description>
    <Copyright>Copyright © 2026 jiun264</Copyright>
    <PackageProjectUrl>https://github.com/jiun264/WIN_TO_IPAD</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

</Project>
