<Window x:Class="PhotoBridge.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoBridge - 高速照片區網直傳 (iPad)" Height="760" Width="1100"
        MinHeight="600" MinWidth="850"
        Background="#F4F6F8">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部標題列 -->
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="PhotoBridge" FontSize="28" FontWeight="Bold" Foreground="#1F2328"/>
                <TextBlock Text="PC 挑選照片，高速零拷貝直傳 iPad（極速 Wi-Fi 串流）"
                           Margin="0,4,0,0" Foreground="#59636E" FontSize="14"/>
            </StackPanel>
        </DockPanel>

        <!-- 資料夾選擇區 -->
        <Border Grid.Row="1" Margin="0,16,0,10" Padding="14"
                Background="White" CornerRadius="8" BorderBrush="#E1E4E8" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button x:Name="ChooseFolderButton" DockPanel.Dock="Left"
                        Content="選擇照片資料夾" Padding="16,8" FontWeight="Medium"
                        Click="ChooseFolderButton_Click"/>
                <TextBlock x:Name="FolderPathText" Margin="14,0,0,0"
                           VerticalAlignment="Center" Text="尚未選擇資料夾"
                           Foreground="#59636E" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 配對與伺服器連線狀態面板 -->
        <Border x:Name="ServerStatusPanel" Grid.Row="2" Margin="0,0,0,10" Padding="14"
                Background="#EBF5FB" CornerRadius="8" BorderBrush="#A9CCE3" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#27AE60" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="極速傳輸伺服器運行中" FontWeight="Bold" FontSize="15" Foreground="#1B4F72"/>
                    </StackPanel>

                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="連線網址：" Foreground="#5499C7" FontWeight="Medium"/>
                        <TextBlock x:Name="ServerAddressText" Text="http://192.168.1.x:8765" FontWeight="SemiBold" Foreground="#154360"/>
                        <Button x:Name="CopyAddressButton" Content="複製網址" Margin="10,0,20,0" Padding="8,2"
                                FontSize="12" Click="CopyAddressButton_Click"/>

                        <TextBlock Text="配對碼：" Foreground="#5499C7" FontWeight="Medium" Margin="10,0,0,0"/>
                        <TextBlock x:Name="PairingCodeText" Text="123456" FontSize="18" FontWeight="Bold"
                                   Foreground="#C0392B" Margin="6,-2,0,0"/>
                    </WrapPanel>

                    <TextBlock x:Name="ServerLogText" Text="等待 iPad 連線並同步..." Margin="0,8,0,0"
                               Foreground="#59636E" FontSize="13" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="StopServerButton" Grid.Column="1" Content="停止伺服器"
                        Padding="14,8" VerticalAlignment="Center" Background="#FDEDEC"
                        Foreground="#C0392B" BorderBrush="#E6B0AA" FontWeight="Medium"
                        Click="StopServerButton_Click"/>
            </Grid>
        </Border>

        <!-- 照片列表 -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="PhotoGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" IsReadOnly="False"
                      SelectionMode="Extended" HeadersVisibility="Column"
                      Background="White" BorderThickness="1" BorderBrush="#E1E4E8"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="傳送" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                    <DataGridTextColumn Header="檔名" Binding="{Binding FileName}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="格式" Binding="{Binding Format}" IsReadOnly="True" Width="90"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeLabel}" IsReadOnly="True" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底部控制列 -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="14"
                Background="White" CornerRadius="8" BorderBrush="#E1E4E8" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectAllButton" Content="全選" Padding="12,5" Margin="0,0,6,0" Click="SelectAllButton_Click"/>
                    <Button x:Name="DeselectAllButton" Content="全不選" Padding="12,5" Margin="0,0,16,0" Click="DeselectAllButton_Click"/>
                    <TextBlock x:Name="SelectionSummaryText" VerticalAlignment="Center"
                               Text="請先選擇照片資料夾" Foreground="#59636E" FontSize="14"/>
                </StackPanel>

                <Button x:Name="SendButton" DockPanel.Dock="Right"
                        Content="啟動直傳服務" Padding="20,9" FontSize="14"
                        FontWeight="SemiBold" Background="#0969DA" Foreground="White"
                        IsEnabled="False" Click="SendButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
