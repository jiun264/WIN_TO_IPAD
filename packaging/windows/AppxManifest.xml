<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="jiun264.PhotoBridge"
    Publisher="CN=jiun264"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PhotoBridge</DisplayName>
    <PublisherDisplayName>jiun264</PublisherDisplayName>
    <Logo>AppIcon-256.png</Logo>
    <Description>PC to iPad High-Speed LAN Photo Transfer</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-TW" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="PhotoBridge"
      Executable="PhotoBridge.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PhotoBridge"
        Description="PC to iPad High-Speed LAN Photo Transfer"
        BackgroundColor="#0A3C8C"
        Square150x150Logo="AppIcon-256.png"
        Square44x44Logo="AppIcon-256.png">
        <uap:DefaultTile Wide310x150Logo="AppIcon-256.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="internetClientServer" />
  </Capabilities>
</Package>
